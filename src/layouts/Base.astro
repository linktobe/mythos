---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '北欧诸神的中文词条。所载故事各著出处；诸书异说，并列存之。' } = Astro.props;
const path = Astro.url.pathname;
const active = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <noscript><style>.reveal{opacity:1 !important;}</style></noscript>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23f7f3ec'/><text x='16' y='23' font-size='20' text-anchor='middle' fill='%239c3b2e' font-family='serif'>神</text></svg>" />
  </head>
  <body>
    <header class="site-head">
      <div class="inner">
        <a class="brand" href="/">
          神话图鉴
          <small>MYTHOS · 原典优先</small>
        </a>
        <nav class="nav">
          <a href="/" aria-current={active('/') ? 'page' : undefined}>词条</a>
          <a href="/qi" aria-current={active('/qi') ? 'page' : undefined}>器物</a>
          <a href="/tu" aria-current={active('/tu') ? 'page' : undefined}>关系图</a>
          <a href="/about" aria-current={active('/about') ? 'page' : undefined}>编例</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="inner">
        <p>叙事以 T0 原典为主干，T1 汇编仅作兜底并标注。</p>
        <p>代码 MIT · 词条文本 CC BY-SA 4.0 · 所引古典文本属公有领域</p>
      </div>
    </footer>
    <script>
      // 载入即入场：所有 .reveal 一次性加上 .in，由 CSS 的 --d 变量做错峰。
      // 不做滚动触发——文本站常有深链接，内容不能因为没滚动就一直隐身。
      const els = Array.from(document.querySelectorAll('.reveal'));
      requestAnimationFrame(() => {
        for (const el of els) el.classList.add('in');
      });
    </script>
  </body>
</html>
