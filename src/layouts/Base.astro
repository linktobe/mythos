---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '神话人物图鉴：以原典为主干的中文词条与关系图谱。' } = Astro.props;
const path = Astro.url.pathname;
const active = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23f7f3ec'/><text x='16' y='23' font-size='20' text-anchor='middle' fill='%239c3b2e' font-family='serif'>神</text></svg>" />
  </head>
  <body>
    <header class="site-head">
      <div class="inner">
        <a class="brand" href="/">
          神话图鉴
          <small>MYTHOS · 原典优先</small>
        </a>
        <nav class="nav">
          <a href="/" aria-current={active('/') ? 'page' : undefined}>词条</a>
          <a href="/tu" aria-current={active('/tu') ? 'page' : undefined}>关系图</a>
          <a href="/about" aria-current={active('/about') ? 'page' : undefined}>编例</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="inner">
        <p>叙事以 T0 原典为主干，T1 汇编仅作兜底并标注；冲突版本并列，不缝合、不裁决。</p>
        <p>代码 MIT · 词条文本 CC BY-SA 4.0 · 所引古典文本属公有领域</p>
      </div>
    </footer>
  </body>
</html>
