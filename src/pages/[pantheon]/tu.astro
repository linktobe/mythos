---
import Base from '../../layouts/Base.astro';
import { livePantheons, getSystem, getGraph, entryHref } from '../../lib/content';

export function getStaticPaths() {
  const paths = [];
  for (const p of livePantheons) {
    const system = getSystem(p.id);
    const graph = getGraph(p.id);
    if (!graph) continue;
    paths.push({ params: { pantheon: p.id }, props: { p, system, graph } });
  }
  return paths;
}

const { p, system, graph } = Astro.props;
const { nodes, links, width, height } = graph;
const byId: Map<string, any> = new Map(nodes.map((n: any) => [n.id, n]));
const centerName = byId.get(graph.center)?.name ?? '中心人物';

const linkLines = links
  .map((l: any) => {
    const a = byId.get(l.source);
    const b = byId.get(l.target);
    return a && b ? { x1: a.x, y1: a.y, x2: b.x, y2: b.y, s: l.source, t: l.target } : null;
  })
  .filter(Boolean);
---

<Base
  title={`关系图 · ${p.zh}`}
  description={`${p.zh}人物之间的关系图：亲缘、血盟、婚姻、敌对、宿命。`}
  pantheon={p}
  crumbs={[
    { label: '神话图鉴', href: '/' },
    { label: p.zh, href: `/${p.id}/` },
    { label: '关系图' },
  ]}
>
  <div class="wrap-wide">
    <a class="back" href={`/${p.id}/`}>← 返回{p.zh}</a>
    <header class="list-head">
      <h1>关系图</h1>
      <p class="lede">
        {nodes.length} 个人物、{links.length} 条关系，以{centerName}为中心。悬停高亮直接关系，点击进入词条。
        此图只画人物之间的连线；器物、群体、地区与事件的关联，保留在各词条页的「关系」区。
      </p>
    </header>

    <div class="graph-wrap reveal">
      <svg class="graph-svg" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${p.zh}人物关系图`}>
        <g class="links">
          {linkLines.map((l) => (
            <line class="link" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} data-s={l.s} data-t={l.t} />
          ))}
        </g>
        <g class="nodes">
          {nodes.map((n: any) => (
            <a href={entryHref(p.id, n.id)} class="node" data-id={n.id}>
              <circle cx={n.x} cy={n.y} r={n.r} />
              <text x={n.x} y={n.y + n.r + 14}>{n.name}</text>
            </a>
          ))}
        </g>
      </svg>
      <div class="legend">
        <span>亲缘 / 血盟 / 婚姻</span>
        <span>敌对 / 宿命</span>
        <span>从属 / 师承 / 同源</span>
        <span class="legend-end">圆圈大小 = 关系数量</span>
      </div>
    </div>
  </div>

  <script>
    const svg = document.querySelector<SVGSVGElement>('.graph-svg');
    if (svg) {
      const lines = Array.from(svg.querySelectorAll<SVGLineElement>('.link'));
      const nodes = Array.from(svg.querySelectorAll<SVGAElement>('.node'));

      const clear = () => {
        svg.classList.remove('dim');
        for (const l of lines) l.classList.remove('hl');
        for (const n of nodes) n.classList.remove('hl');
      };

      for (const node of nodes) {
        const id = node.dataset.id;
        node.addEventListener('mouseenter', () => {
          svg.classList.add('dim');
          node.classList.add('hl');
          for (const l of lines) {
            if (l.dataset.s === id || l.dataset.t === id) {
              l.classList.add('hl');
              const other = l.dataset.s === id ? l.dataset.t : l.dataset.s;
              const peer = nodes.find((n) => n.dataset.id === other);
              if (peer) peer.classList.add('hl');
            }
          }
        });
        node.addEventListener('mouseleave', clear);
      }
    }
  </script>
</Base>
