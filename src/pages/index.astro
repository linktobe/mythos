---
import Base from '../layouts/Base.astro';
import { pantheons, totals, livePantheons, systems, entryHref } from '../lib/content';

// 速览：各体系各取几条，凑够 8 条（体系多了就轮着来，不让一套占满）
const preview = [];
const perPantheon = Math.max(1, Math.ceil(8 / Math.max(1, livePantheons.length)));
for (const p of livePantheons) {
  const sys = systems[p.id];
  for (const e of (sys?.entries ?? []).slice(0, perPantheon)) {
    preview.push({ ...e, pantheon: p.id, pantheonZh: p.zh });
  }
}
---

<Base title="神话图鉴 · 多体系中文词条库">
  <div class="wrap">
    <header class="list-head">
      <h1>神话图鉴</h1>
      <p class="lede">
        几套神话的中文词条，各自成体系。所载故事各著出处；诸书异说，并列存之，不设唯一正典。
      </p>
      <div class="stats">
        <span>{livePantheons.length} 套体系</span>
        <span>{totals.entries} 条词目</span>
        <span>{totals.relations} 条关系</span>
        <span>{totals.sources} 种典籍</span>
      </div>
    </header>

    <section class="search-block" aria-label="全站搜索">
      <label class="search-label" for="q">搜索全部体系</label>
      <div class="search-box">
        <input id="q" type="search" autocomplete="off" spellcheck="false" placeholder="输入中文名、原文名或别名，如 奥丁 / Óðinn" />
        <kbd class="search-hint">/</kbd>
      </div>
      <ul class="search-results" id="results" role="listbox" aria-label="搜索结果"></ul>
      <p class="search-empty" id="search-empty" hidden>没有匹配的词条。</p>
    </section>

    <h2>各体系</h2>
    <nav class="sections pantheons" aria-label="神话体系">
      {
        pantheons.map((p) => (
          <a class:list={['section-card', { planned: p.status !== 'live' }]} href={p.status === 'live' ? `/${p.id}/` : undefined} aria-disabled={p.status !== 'live' ? 'true' : undefined}>
            <span class="section-n">{p.status === 'live' ? p.counts.entries : '—'}</span>
            <span class="section-name">{p.zh}</span>
            <span class="section-desc">{p.status === 'live' ? p.description : '筹备中，尚未开放'}</span>
          </a>
        ))
      }
    </nav>

    <h2>最近收录</h2>
    <section class="cards">
      {
        preview.map((e, i) => (
          <a class="card reveal" style={`--d:${i * 45}ms`} href={entryHref(e.pantheon, e.id)}>
            <div class="name">
              <span class="n">{e.name}</span>
              <span class="alias">{e.name_original}</span>
            </div>
            <div class="desc">{e.summary}</div>
            <div class="tags">
              <span class="tag-type">{e.pantheonZh}</span>
              <span class="tag-role">{e.role.title}</span>
            </div>
          </a>
        ))
      }
    </section>
  </div>

  <script>
    // 全站搜索：首屏不加载索引，聚焦后才取，避免每页都背一份 JSON
    const input = document.getElementById('q');
    const list = document.getElementById('results');
    const empty = document.getElementById('search-empty');
    let index = null;
    let loading = null;

    const load = () => {
      if (!loading) {
        loading = fetch('/search-index.json')
          .then((r) => r.json())
          .then((data) => (index = data))
          .catch(() => (index = []));
      }
      return loading;
    };

    const render = (hits) => {
      list.textContent = '';
      empty.hidden = hits.length > 0;
      for (const h of hits) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = h.url;
        a.className = 'search-hit';
        a.textContent = h.name;
        const meta = document.createElement('span');
        meta.className = 'search-meta';
        meta.textContent = [h.name_original, h.entity_type, h.pantheon_zh].filter(Boolean).join(' · ');
        a.append(meta);
        li.append(a);
        list.append(li);
      }
    };

    const search = async (q) => {
      const term = q.trim().toLowerCase();
      if (!term) {
        render([]);
        empty.hidden = true;
        return;
      }
      await load();
      const hits = index
        .filter((h) => {
          const hay = [h.name, h.name_original, ...(h.aliases || [])].join(' ').toLowerCase();
          return hay.includes(term);
        })
        .slice(0, 12);
      render(hits);
    };

    input?.addEventListener('input', (e) => search((e.target as HTMLInputElement).value));
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const first = list.querySelector('a');
        if (first) window.location.href = first.href;
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input?.focus();
      }
    });
  </script>
</Base>
