---
import Base from '../layouts/Base.astro';
import data from '../generated/entities.json';

const { entries, vocab, counts } = data;

const KIND_PEOPLE = new Set(['神祇', '巨人', '矮人', '异兽']);
const people = entries.filter((e) => KIND_PEOPLE.has(e.entity_type));
const groups = entries.filter((e) => e.entity_type === '群体');
const vessels = entries.filter((e) => e.entity_type === '器物');
const places = entries.filter((e) => e.entity_type === '地区');
const events = entries.filter((e) => e.entity_type === '事件');

const sections = [
  { href: '/', label: '词条', desc: '神祇、巨人、矮人、异兽', n: people.length },
  { href: '/qun', label: '群体', desc: '族群与军团', n: groups.length },
  { href: '/qi', label: '器物', desc: '兵刃、宝物与桥', n: vessels.length },
  { href: '/di', label: '地区', desc: '九界与它们的来历', n: places.length },
  { href: '/shi', label: '事件', desc: '把人物串成时间线', n: events.length },
  { href: '/tu', label: '关系图', desc: '人物之间的关系网', n: counts.relations },
];

const vocabIndex = {
  lineage: new Map(vocab.lineage.map((x) => [x.id, x])),
  camp: new Map(vocab.camp.map((x) => [x.id, x])),
  realm: new Map(vocab.realm.map((x) => [x.id, x])),
};
const tagOf = (axis, id) => vocabIndex[axis]?.get(id)?.zh ?? id;
---

<Base title="神话图鉴 · 词条">
  <div class="wrap">
    <header class="list-head">
      <h1>神话图鉴</h1>
      <p style="color: var(--muted); margin: 0;">北欧诸神的中文词条。所载故事各著出处；诸书异说，并列存之。</p>
      <div class="stats">
        <span>{counts.entries} 条词目</span>
        <span>{counts.relations} 条关系</span>
        <span>{counts.sources} 种典籍</span>
      </div>
    </header>

    <nav class="sections" aria-label="分类">
      {sections.map((s) => (
        <a class="section-card" href={s.href}>
          <span class="section-n">{s.n}</span>
          <span class="section-name">{s.label}</span>
          <span class="section-desc">{s.desc}</span>
        </a>
      ))}
    </nav>

    <h2>最近收录</h2>
    <section class="cards">
      {people.map((e, i) => (
        <a class="card reveal" style={`--d:${i * 45}ms`} href={`/shen/${e.id}`}>
          <div class="name">
            {e.name}
            <span class="alias">{e.name_latin}</span>
          </div>
          <div class="desc">{e.summary}</div>
          <div class="tags">
            {e.entity_type !== '神祇' && <span class="tag-type">{e.entity_type}</span>}
            <span class="tag-role">{e.role.title}</span>
            {e.identity.lineage.slice(0, 1).map((x) => {
              const t = tagOf('lineage', x.id);
              return t === e.entity_type ? null : <span>{t}</span>;
            })}
            {e.identity.realm.slice(0, 1).map((x) => <span>{tagOf('realm', x.id)}</span>)}
          </div>
        </a>
      ))}
    </section>
  </div>
</Base>
