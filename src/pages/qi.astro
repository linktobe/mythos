---
import Base from '../layouts/Base.astro';
import data from '../generated/entities.json';

const vessels = data.entries.filter((e) => e.entity_type === '器物');
const realmName = new Map(data.vocab.realm.map((r) => [r.id, r.zh]));
---

<Base title="器物 · 神话图鉴" description="北欧神话中的器物：雷神之锤、彩虹桥、缚狼之绳。">
  <div class="wrap">
    <a class="back" href="/">← 返回首页</a>
    <header class="list-head">
      <h1>器物</h1>
      <p style="color: var(--muted); margin: 0;">诸神与巨人手中的兵刃、桥与绳。此处只列器物，不与人神混排。</p>
      <div class="stats">
        <span>{vessels.length} 件</span>
      </div>
    </header>

    <section class="cards">
      {vessels.map((e, i) => (
        <a class="card reveal" style={`--d:${i * 45}ms`} href={`/shen/${e.id}`}>
          <div class="name">
            {e.name}
            <span class="alias">{e.name_latin}</span>
          </div>
          <div class="desc">{e.summary}</div>
          <div class="tags">
            <span class="tag-role">{e.role.title}</span>
            {e.identity.realm.slice(0, 1).map((x) => <span>{realmName.get(x.id) ?? x.id}</span>)}
          </div>
        </a>
      ))}
    </section>
  </div>
</Base>
