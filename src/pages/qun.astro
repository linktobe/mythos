---
import Base from '../layouts/Base.astro';
import data from '../generated/entities.json';

const groups = data.entries.filter((e) => e.entity_type === '群体');
const lineageName = new Map(data.vocab.lineage.map((l) => [l.id, l.zh]));
---

<Base title="群体 · 神话图鉴" description="北欧神话中的族群与军团：女武神、矮人。">
  <div class="wrap">
    <header class="list-head">
      <h1>群体</h1>
      <p style="color: var(--muted); margin: 0;">按族类或职能结成的集体。个体的故事分散在各自的词条里，此处只记这一群人的来路与职司。</p>
      <div class="stats">
        <span>{groups.length} 类</span>
      </div>
    </header>

    <section class="cards">
      {groups.map((e, i) => (
        <a class="card reveal" style={`--d:${i * 45}ms`} href={`/shen/${e.id}`}>
          <div class="name">
            {e.name}
            <span class="alias">{e.name_latin}</span>
          </div>
          <div class="desc">{e.summary}</div>
          <div class="tags">
            <span class="tag-role">{e.role.title}</span>
            {e.identity.lineage.slice(0, 1).map((x) => <span>{lineageName.get(x.id) ?? x.id}</span>)}
          </div>
        </a>
      ))}
    </section>
  </div>
</Base>
