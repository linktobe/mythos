---
import Base from '../layouts/Base.astro';
import data from '../generated/entities.json';

const events = data.entries.filter((e) => e.entity_type === '事件');
---

<Base title="事件 · 神话图鉴" description="北欧神话中的关键事件：诸神黄昏。">
  <div class="wrap">
    <a class="back" href="/">← 返回首页</a>
    <header class="list-head">
      <h1>事件</h1>
      <p style="color: var(--muted); margin: 0;">把散落的人物串成时间线的那些节点。</p>
      <div class="stats">
        <span>{events.length} 起</span>
      </div>
    </header>

    <section class="cards">
      {events.map((e, i) => (
        <a class="card reveal" style={`--d:${i * 45}ms`} href={`/shen/${e.id}`}>
          <div class="name">
            {e.name}
            <span class="alias">{e.name_latin}</span>
          </div>
          <div class="desc">{e.summary}</div>
          <div class="tags">
            <span class="tag-role">{e.role.title}</span>
            <span>事件</span>
          </div>
        </a>
      ))}
    </section>
  </div>
</Base>
