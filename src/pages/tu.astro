---
import Base from '../layouts/Base.astro';
import graph from '../generated/graph.json';

const { nodes, links, width, height } = graph;
const byId = new Map(nodes.map((n) => [n.id, n]));

const linkLines = links
  .map((l) => {
    const a = byId.get(l.source);
    const b = byId.get(l.target);
    return a && b ? { x1: a.x, y1: a.y, x2: b.x, y2: b.y, s: l.source, t: l.target, kind: l.kind } : null;
  })
  .filter(Boolean);
---

<Base title="关系图 · 神话图鉴" description="神话人物之间的关系图谱：亲缘、血盟、婚姻、敌对、宿命。">
  <div class="wrap-wide">
    <header class="list-head">
      <h1>关系图</h1>
      <p style="color: var(--muted); margin: 0;">
        {nodes.length} 个节点、{links.length} 条关系。悬停任一节点高亮它的直接关系，点击进入词条。
      </p>
    </header>

    <div class="graph-wrap reveal">
      <svg class="graph-svg" viewBox={`0 0 ${width} ${height}`} role="img" aria-label="神话人物关系图">
        <g class="links">
          {linkLines.map((l) => (
            <line class="link" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} data-s={l.s} data-t={l.t} />
          ))}
        </g>
        <g class="nodes">
          {nodes.map((n) => (
            <a href={`/shen/${n.id}`} class="node" data-id={n.id}>
              <circle cx={n.x} cy={n.y} r={n.r} />
              <text x={n.x} y={n.y + n.r + 14}>{n.name}</text>
            </a>
          ))}
        </g>
      </svg>
      <div class="legend">
        <span>亲缘 / 血盟 / 婚姻</span>
        <span>敌对 / 宿命</span>
        <span>从属 / 师承 / 同源</span>
        <span style="margin-left:auto">圆圈大小 = 关系数量</span>
      </div>
    </div>
  </div>

  <script>
    const svg = document.querySelector('.graph-svg');
    if (svg) {
      const lines = Array.from(svg.querySelectorAll('.link'));
      const nodes = Array.from(svg.querySelectorAll('.node'));

      const clear = () => {
        svg.classList.remove('dim');
        lines.forEach((l) => l.classList.remove('hl'));
        nodes.forEach((n) => n.classList.remove('hl'));
      };

      nodes.forEach((node) => {
        const id = node.dataset.id;
        node.addEventListener('mouseenter', () => {
          svg.classList.add('dim');
          node.classList.add('hl');
          lines.forEach((l) => {
            if (l.dataset.s === id || l.dataset.t === id) {
              l.classList.add('hl');
              const other = l.dataset.s === id ? l.dataset.t : l.dataset.s;
              const peer = nodes.find((n) => n.dataset.id === other);
              if (peer) peer.classList.add('hl');
            }
          });
        });
        node.addEventListener('mouseleave', clear);
      });
    }
  </script>
</Base>
